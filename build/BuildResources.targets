<Project>

  <!--
    Local builds stage the module in the repo's dist folder, never in the game's Modules folder
    (the SDK otherwise falls back to the Steam install). CI keeps the SDK default.
  -->
  <PropertyGroup Condition="'$(CI)' != 'true'">
    <GameFolder>$(MSBuildThisFileDirectory)..\dist</GameFolder>
  </PropertyGroup>

  <Target Name="CreateDistFolder" BeforeTargets="PostBuildEvent" Condition="'$(CI)' != 'true'">
    <MakeDir Directories="$(GameFolder)" />
  </Target>

  <!--
    Opt-in deploy: -p:DeployToMods=true mirrors the staged module into ModsDeployFolder, set in the
    uncommitted Deploy.local.props. Debug symbols and the deps manifest are left out, stale files removed.
  -->
  <Import Project="Deploy.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Deploy.local.props')" />

  <Target Name="DeployToMods" AfterTargets="CopyModule" Condition="'$(DeployToMods)' == 'true'">
    <Error Condition="'$(ModsDeployFolder)' == ''" Text="Set ModsDeployFolder in build\Deploy.local.props to deploy." />
    <Error Condition="$(ModsDeployFolder.Contains('steamapps'))" Text="Refusing to deploy into the game folder: $(ModsDeployFolder)" />

    <PropertyGroup>
      <_StagedModule>$(GameFolder)\Modules\$(ModuleId)</_StagedModule>
      <_DeployBin>$(ModsDeployFolder)\bin\Win64_Shipping_Client</_DeployBin>
    </PropertyGroup>
    <ItemGroup>
      <_DeployDlls Include="$(_StagedModule)\bin\Win64_Shipping_Client\*.dll" />
      <_ExistingDeployFiles Include="$(_DeployBin)\*" />
      <_StaleDeployFiles Include="@(_ExistingDeployFiles)" Exclude="@(_DeployDlls->'$(_DeployBin)\%(Filename)%(Extension)')" />
    </ItemGroup>

    <Delete Files="@(_StaleDeployFiles)" />
    <Copy SourceFiles="$(_StagedModule)\SubModule.xml" DestinationFolder="$(ModsDeployFolder)" />
    <Copy SourceFiles="@(_DeployDlls)" DestinationFolder="$(_DeployBin)" />
    <Message Importance="high" Text="Deployed $(ModuleId) to $(ModsDeployFolder)" />
  </Target>

</Project>
